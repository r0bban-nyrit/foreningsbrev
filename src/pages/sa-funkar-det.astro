---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import CTA from '../components/CTA.astro';
import PriceCalculator from '../components/PriceCalculator';

const steps = [
  { title: 'Kontakt', text: 'Ni hör av er med vad ni vill nå ut med, till vem och när.' },
  { title: 'Förslag & offert', text: 'Vi tar fram ett upplägg och ett fast pris för utskicket.' },
  { title: 'Korrektur', text: 'Ni granskar text och layout. Vi justerar tills det känns rätt.' },
  { title: 'Utskick', text: 'Vi trycker och skickar, och meddelar när allt är levererat.' },
];

// Exempelpriser – justera till era riktiga priser (samma värden som i PriceCalculator.tsx).
const plans = [
  {
    name: 'Digitalt',
    price: 'från 1 500 kr',
    desc: 'E-postutskick med er layout.',
    features: ['Text & layout', 'Utskick via e-post', 'Er medlemslista som mottagare'],
  },
  {
    name: 'Tryckt brev',
    price: 'från 1 500 kr + porto',
    desc: 'Klassiskt brev i brevlådan.',
    features: ['Text & layout', 'Tryck & kuvertering', 'Postutdelning'],
    featured: true,
  },
  {
    name: 'Årlig kampanj',
    price: 'Offert',
    desc: 'Återkommande utskick, t.ex. knattekampanj varje år.',
    features: ['Allt i tryckt brev', 'Uppdaterade mottagare varje år', 'Påminnelse inför säsong'],
  },
];
---

<BaseLayout
  title="Så funkar det & priser"
  description="Så går ett utskick till – från kontakt till leverans – och vad det kostar."
>
  <Hero
    eyebrow="Så funkar det"
    title="Från idé till brevlåda i fyra steg"
    lead="Ni behöver inte kunna något om tryck eller utskick. Vi guidar er genom hela processen och ni godkänner allt innan det skickas."
  />

  <section class="container-page py-16">
    <Steps steps={steps} />
  </section>

  <section id="priser" class="scroll-mt-24 bg-slate-50 py-16">
    <div class="container-page">
      <h2 class="text-3xl font-bold text-brand-900">Priser</h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Exempelpriser exkl. moms. Ni får alltid en offert med fast pris innan något beställs.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          plans.map((p) => (
            <div
              class:list={[
                'flex flex-col rounded-2xl border bg-white p-6',
                p.featured ? 'border-brand-600 ring-2 ring-brand-600' : 'border-slate-200',
              ]}
            >
              <h3 class="text-lg font-bold text-brand-900">{p.name}</h3>
              <p class="mt-1 text-sm text-slate-600">{p.desc}</p>
              <p class="mt-4 text-2xl font-extrabold text-brand-900">{p.price}</p>
              <ul class="mt-4 space-y-2 text-sm text-slate-700">
                {p.features.map((f) => (
                  <li>✓ {f}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12 max-w-2xl">
        <PriceCalculator client:visible />
      </div>
    </div>
  </section>

  <CTA title="Vill ni ha en offert?" text="Berätta hur många mottagare ni har och vilken typ av utskick ni tänker er." />
</BaseLayout>
