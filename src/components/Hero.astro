---
interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-gradient-to-b from-brand-50 to-white">
  <div class="container-page py-16 sm:py-24">
    <div class="max-w-3xl">
      {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">{eyebrow}</p>}
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-brand-900 text-balance sm:text-5xl">{title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">{lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <slot />
      </div>
    </div>
  </div>
</section>
