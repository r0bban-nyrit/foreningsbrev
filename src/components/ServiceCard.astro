---
interface Props {
  icon: 'members' | 'sponsors' | 'recruit';
  title: string;
  text: string;
  href?: string;
}
const { icon, title, text, href } = Astro.props;

const paths: Record<Props['icon'], string> = {
  members: 'M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm-12 9c0-3 3.6-5 8-5s8 2 8 5',
  sponsors: 'M12 3l2.6 5.4 5.9.9-4.3 4.1 1 5.9L12 16.5 6.8 19.3l1-5.9-4.3-4.1 5.9-.9L12 3Z',
  recruit: 'M12 5v14M5 12h14',
};
---

<article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={paths[icon]}></path>
    </svg>
  </div>
  <h3 class="mt-4 text-lg font-bold text-brand-900">{title}</h3>
  <p class="mt-2 flex-1 text-slate-600">{text}</p>
  {href && <a href={href} class="mt-4 font-semibold text-brand-700 hover:underline">Läs mer →</a>}
</article>
