---
import { url, CONTACT_EMAIL } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-3">
    <div>
      <p class="font-bold text-brand-900">Föreningsbrev</p>
      <p class="mt-2 text-sm text-slate-600">
        Utskick för föreningar – till medlemmar, sponsorer och nya medlemmar.
      </p>
    </div>
    <nav aria-label="Sidfot" class="flex flex-col gap-2 text-sm">
      <a href={url('/')} class="text-slate-600 hover:text-brand-700">Start</a>
      <a href={url('/tjanster')} class="text-slate-600 hover:text-brand-700">Tjänster</a>
      <a href={url('/sa-funkar-det')} class="text-slate-600 hover:text-brand-700">Så funkar det & priser</a>
    </nav>
    <div class="text-sm">
      <p class="font-semibold text-slate-800">Kontakt</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="mt-2 inline-block text-brand-700 hover:underline">{CONTACT_EMAIL}</a>
    </div>
  </div>
  <div class="border-t border-slate-200 py-4 text-center text-xs text-slate-500">
    © {year} Föreningsbrev
  </div>
</footer>
